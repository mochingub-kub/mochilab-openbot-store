#!/usr/bin/env bash
# OpenBot 0.49.0: verify seccomp and load one OpenBot-only AppArmor policy.
# This hook never changes docker-default, Docker daemon config, or sysctls.
set -euo pipefail
APP_DIR="${APP_DATA_DIR:-$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/..")}"
SECCOMP="${APP_DIR}/seccomp-0.49.0.json"
SECCOMP_URL="https://raw.githubusercontent.com/nightly-labs/openbot/v0.49.0/docker/seccomp.json"
SECCOMP_GIT_SHA="6e42d0bd8e904f5ddddaf3c6c7c50f1dc2d72418"
APPARMOR_PROFILE="${APP_DIR}/hooks/mochilab-openbot.apparmor"
APPARMOR_GIT_SHA="fc27398ef8a2404f2c2f0ef7e6aaab411a9ec73a"

# The upstream profile is a pinned release artifact; do not use unconfined.
command -v git >/dev/null || { echo 'OpenBot: git is required to verify seccomp' >&2; exit 1; }
if [[ ! -f "$SECCOMP" ]] || [[ "$(git hash-object "$SECCOMP")" != "$SECCOMP_GIT_SHA" ]]; then
  command -v curl >/dev/null || { echo 'OpenBot: curl is required to obtain seccomp' >&2; exit 1; }
  TMP="$(mktemp "${APP_DIR}/.seccomp-0.49.0.XXXXXX")"
  trap 'rm -f "$TMP"' EXIT
  curl --fail --location --silent --show-error --retry 2 --connect-timeout 10 --max-time 60 \
    "$SECCOMP_URL" --output "$TMP"
  [[ "$(git hash-object "$TMP")" == "$SECCOMP_GIT_SHA" ]] || {
    echo 'OpenBot: seccomp checksum mismatch; refusing file' >&2
    exit 1
  }
  chmod 0644 "$TMP"
  mv -f "$TMP" "$SECCOMP"
fi

# AppArmor stays in enforce mode; only this named OpenBot profile gains userns create.
[[ -f "$APPARMOR_PROFILE" ]] || { echo 'OpenBot: AppArmor policy missing' >&2; exit 1; }
[[ "$(git hash-object "$APPARMOR_PROFILE")" == "$APPARMOR_GIT_SHA" ]] || {
  echo 'OpenBot: AppArmor policy was modified; refusing to load' >&2
  exit 1
}
PARSER="$(command -v apparmor_parser || true)"
if [[ -z "$PARSER" ]]; then
  for candidate in /usr/sbin/apparmor_parser /sbin/apparmor_parser; do
    if [[ -x "$candidate" ]]; then PARSER="$candidate"; break; fi
  done
fi
[[ -n "$PARSER" ]] || { echo 'OpenBot: AppArmor parser unavailable' >&2; exit 1; }

# Parse without touching the kernel or cache, then load only mochilab-openbot.
"$PARSER" -Q -T -K "$APPARMOR_PROFILE"
if [[ ! -r /sys/kernel/security/apparmor/profiles ]] || \
   ! grep -Fxq 'mochilab-openbot (enforce)' /sys/kernel/security/apparmor/profiles; then
  "$PARSER" -r -T -K "$APPARMOR_PROFILE"
fi
# Fail closed: Docker refuses to launch when the named profile is unavailable.
